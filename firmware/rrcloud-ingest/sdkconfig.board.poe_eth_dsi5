# Overlay for the Waveshare ESP32-P4-WIFI6-POE-ETH with an 800x480 Raspberry Pi DSI touch
# display (Hosyond / OSOYOO 5-inch type) on its DSI connector, applied on top of sdkconfig.defaults:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.board.poe_eth_dsi5" build
# (README "Building and flashing"). Ethernet, PoE and USB-A as the plain PoE-ETH build; without
# a display attached the image runs headless.
CONFIG_RRC_BOARD_P4_POE_ETH_DSI5=y

# ---- LVGL 9 (the on-screen UI, components/rrc_ui), the same settings as the Touch-LCD-4.3
# build: the UI renders at 480x800 portrait into draw buffers in PSRAM and is rotated onto the
# 800x480 panel (main/display.c); internal RAM stays with TLS, AES-DMA and the task stacks.
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL's heap comes from PSRAM through main/display.c (malloc would place every
# small widget allocation in internal RAM: SPIRAM_MALLOC_ALWAYSINTERNAL=16384).
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DPI_DEF=187
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Text is Roboto + Material Symbols, compiled into components/rrc_ui/fonts; LVGL's own
# Montserrat 14 only backs the theme default and is never shown.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=n
CONFIG_LV_USE_QRCODE=y
# Widgets the UI does not use stay out of the image.
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
