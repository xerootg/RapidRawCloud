# ---- Target / board: Waveshare ESP32-P4-WIFI6-POE-ETH (ESP32-P4NRW32, 32 MB flash, 32 MB PSRAM)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# IDF >= 6.0 only (ignored with a warning on 5.x): keep booting on rev 0.x/1.x modules.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---- PSRAM: transfer buffers (8 MiB upload parts) live here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- Compiler / RTOS
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ---- Ethernet: internal EMAC + IP101GRI over RMII (REF_CLK in on GPIO50)
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y

# ---- Wi-Fi 6 via the on-board ESP32-C6 (ESP-Hosted slave firmware, SDIO)
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_HOST=y

# ---- USB host (USB 2.0 OTG HS on the Type-A port)
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
# Cameras can take a moment to settle on the bus after plug-in and after a reset
# (the IDF defaults are 250/30/30 ms). Longer debounce, reset hold and recovery
# cost nothing on a dock and avoid "HUB: Root port reset failed" on slow devices.
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=500
CONFIG_USB_HOST_RESET_HOLD_MS=50
CONFIG_USB_HOST_RESET_RECOVERY_MS=100
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=20

# ---- FATFS (camera cards: long names, UTF-8)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# ---- Networking stack
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_IPV6=y
# Packet counters for the `net` console command and the web reachability self-test
CONFIG_LWIP_STATS=y

# ---- TLS / HTTP
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512

# ---- Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- ESP-Hosted SDIO wiring to the ESP32-C6 (board schematic; these equal the
#      esp_hosted defaults for the P4 but are pinned so a component upgrade can't move them)
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
# The co-processor is brought up from app_main (after Ethernet), not before it.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n

# ---- Diagnostics: DWARF unwinding so a panic prints a real backtrace on RISC-V
# (the raw stack dump is useless for a hardware-reported stack overflow).
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y
# ---- Flash: the board's 32 MB GigaDevice part needs its driver linked for
# 4-byte addressing; without it the generic driver stops at 16 MB and the tail
# of the LittleFS partition (0x820000+0x800000 > 16 MiB) is unreachable.
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y

# ---- Bluetooth LE admin service: NimBLE host on the P4, controller on the ESP32-C6
# over Hosted-HCI (the same SDIO link as Wi-Fi). Peripheral only, one connection,
# LE Secure Connections bonding persisted in NVS, 517-byte ATT MTU for the JSON RPC.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_42_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="rrcloud-ingest"
